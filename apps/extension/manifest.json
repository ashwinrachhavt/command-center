{
  "manifest_version": 3,
  "name": "Command Center Companion",
  "description": "Prepare, review, and apply exact application answers, résumés and cover letters without submitting.",
  "version": "0.4.2",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "nativeMessaging",
    "sidePanel"
  ],
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"],
  "action": {
    "default_title": "Open Command Center Copilot"
  },
  "key": "",
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
