# Generate real local credentials with: python3 scripts/bootstrap.py
POSTGRES_USER=command_center
POSTGRES_DB=command_center
POSTGRES_PASSWORD=GENERATE_WITH_BOOTSTRAP
POSTGRES_PORT=55432
CC_API_TOKEN=GENERATE_WITH_BOOTSTRAP
CC_DATABASE_URL=postgresql+psycopg://command_center:GENERATE_WITH_BOOTSTRAP@127.0.0.1:55432/command_center
CC_FIRECRAWL_URL=http://127.0.0.1:3002
CC_FIRECRAWL_API_KEY=
CC_SEARXNG_URL=http://127.0.0.1:8081
CC_DOCLING_URL=http://127.0.0.1:5001
CC_DOCLING_API_KEY=
CC_BLOB_STORE_PATH=.local/blobs
# Build the isolated execution images and pin the returned sha256 image IDs.
CC_RESEARCH_SANDBOX_IMAGE=
CC_PDF_RENDERER_IMAGE=
CC_EXECUTOR_DOCKER_SOCKET=/var/run/docker.sock
CC_EXECUTOR_DOCKER_GID=0
CC_AGENT_CONCURRENCY=4
RESEARCH_DOCKER_NETWORK=local-services
API_PORT=8000
WEB_PORT=3001

# FastAPI verifies Clerk session JWTs. Run make auth-sync after configuring the Clerk keys below.
CC_AUTH_MODE=clerk
CC_CLERK_ISSUER=
CC_CLERK_AUTHORIZED_PARTIES=["http://localhost:3001","http://127.0.0.1:3001"]
CC_WEB_ORIGIN=http://localhost:3001
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
CLERK_SECRET_KEY=
CC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Server-only provider credentials. The Next.js client never needs these keys.
OPENAI_API_KEY=
GEMINI_API_KEY=
# GOOGLE_API_KEY is accepted as an alias for GEMINI_API_KEY.
GOOGLE_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
# Native, explicit contact discovery. Provider plan and credits apply.
APOLLO_API_KEY=
HUNTER_API_KEY=

# Optional local request tracing. Run make langfuse-setup to generate local keys.
CC_LANGFUSE_ENABLED=false
# Opt in to bounded, redacted diagnostic content. Originals remain in PostgreSQL.
CC_LANGFUSE_CAPTURE_CONTENT=false
# Optional typed capability routing; use exactly one provider, with no automatic retries.
CC_JEV_ENABLED=false
CC_JEV_PROVIDER=typesafe
TYPESAFE_API_KEY=
# CC_JEV_API_KEY remains a supported legacy alias for TYPESAFE_API_KEY.
# For CC_JEV_PROVIDER=gateway or venice, respectively. Server-only credentials.
AI_GATEWAY_API_KEY=
VENICE_API_KEY=
LANGFUSE_BASE_URL=http://localhost:3003
CC_LANGFUSE_DOCKER_URL=http://host.docker.internal:3003
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
CC_LANGFUSE_USER_EMAIL=admin@command-center.local
CC_LANGFUSE_USER_PASSWORD=
CC_LANGFUSE_DB_PASSWORD=
CC_LANGFUSE_AUTH_SECRET=
CC_LANGFUSE_SALT=
CC_LANGFUSE_ENCRYPTION_KEY=
CC_LANGFUSE_REDIS_PASSWORD=
CC_LANGFUSE_STORAGE_PASSWORD=
COMPOSIO_API_KEY=
CC_COMPOSIO_AUTH_CONFIGS={}
CC_COMPOSIO_ACTION_TIMEOUT_SECONDS=30
CC_REDIS_URL=redis://127.0.0.1:56379/0
CC_INTERNAL_API_URL=http://127.0.0.1:8000
# Optional local mock/readiness endpoints (JSON array); workers wait before consuming jobs.
CC_AGENT_DEPENDENCY_URLS=[]
CC_AGENT_CONFIG=agents/profiles.toml
CC_AGENT_SKILLS_DIR=agents/skills

# Supabase deployment: use postgresql+psycopg:// URLs, including ?sslmode=require.
# CC_DATABASE_POOL_MODE=transaction
# CC_MIGRATION_DATABASE_URL=direct-or-session-pool-connection
# When using transaction pooling, checkpoints require a direct/session connection.
# CC_AGENT_CHECKPOINT_DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
